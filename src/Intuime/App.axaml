<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Intuime.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="#1B2330" />
      <Setter Property="Foreground" Value="#E7EEF6" />
      <Setter Property="BorderBrush" Value="#2E3B4C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="#283448" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#E7A23A" />
      <Setter Property="Foreground" Value="#1A1204" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#F0B45A" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#8EA0B5" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
